<launch>
  <node name="joy_node" pkg="joy" type="joy_node" output="screen">
    <param name="dev" value="/dev/input/js0"/>
    <param name="autorepeat_rate" value="15"/>
  </node>

  <node name="joystick_control" pkg="magician_control" type="joystick_control.py" output="screen">
    <param name="sensitivity" value="3.5"/>
    <param name="input_lockout_s" value="2.0"/>
  </node>

  <node name="arduino_joint_knob_control" pkg="magician_control" type="arduino_joint_knob_control.py" output="screen">
    <param name="step_deg" value="0.25"/>
    <param name="publish_rate" value="50.0"/>
    <rosparam param="device_joint_map">{P1: 0, P2: 1, P3: 2, P4: 3}</rosparam>
    <!-- Optional: set exact Arduino ports here if auto-discovery misses them. -->
    <!-- <rosparam param="ports">[/dev/serial/by-id/usb-...-if00]</rosparam> -->
  </node>

  <node name="general_control" pkg="magician_control" type="general_control.py" output="screen">
    <param name="input_lockout_s" value="2.0"/>
    <!-- Optional: set exact Dobot port here if multiple ttyACM devices are present. -->
    <!-- <param name="dobot_port" value="/dev/serial/by-id/usb-..."/> -->
  </node>
</launch>
